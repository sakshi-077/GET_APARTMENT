<% layout('/layouts/boilerplate') -%>
<body>
  <div id="filters" >
    <div class="filter">
      <a href="/listings?category=Trending" class="filter <%= selectedCategory === 'Trending' ? 'active' : '' %>"
        ><i class="fa fa-fire" aria-hidden="true"></i>
        <p>Trending</p></a
      >
    </div>
    <div class="filter">
      <a href="/listings?category=Rooms" class="filter <%= selectedCategory === 'Rooms' ? 'active' : '' %>">
     <i class="fa fa-bed" aria-hidden="true"></i>
        <p>Rooms</p></a
      >
    </div>
    <div class="filter">
      <a href="/listings?category=Mountains" class="filter <%= selectedCategory === 'Mountains' ? 'active' : '' %>">
        <i class="fa fa-snowflake" aria-hidden="true"></i>
        <p>Mountain</p>
      </a>
    </div>
    <div class="filter">
      <a href="/listings?category=Castles" class="filter <%= selectedCategory === 'Castles' ? 'active' : '' %>">
        <i class="fa fa-chess-rook" aria-hidden="true"></i>
        <p>Castle</p>
      </a>
    </div>
    <div class="filter">
      <a href="/listings?category=Iconic Cities" class="filter <%= selectedCategory === 'Iconic Cities' ? 'active' : '' %>">
        <i class="fa fa-building" aria-hidden="true"></i>
        <p>City</p>
      </a>
    </div>
    <div class="filter">
      <a href="/listings?category=Amazing Pools" class="filter <%= selectedCategory === 'Amazing Pools' ? 'active' : '' %>">
        <i class="fa fa-water" aria-hidden="true"></i>
        <p>Pool</p>
      </a>
    </div>
    <div class="filter">
      <a href="/listings?category=Camping" class="filter <%= selectedCategory === 'Camping' ? 'active' : '' %>">
        <i class="fa fa-campground" aria-hidden="true"></i>
        <p>Camping</p>
      </a>
    </div>
    <div class="filter">
      <a href="/listings?category=Farms" class="filter <%= selectedCategory === 'Farms' ? 'active' : '' %>">
        <i class="fa fa-tractor" aria-hidden="true"></i>
        <p>Farm</p>
      </a>
    </div>
    <div class="filter">
      <a href="/listings?category=Arctic" class="filter <%= selectedCategory === 'Arctic' ? 'active' : '' %>">
        <i class="fa fa-snowflake" aria-hidden="true"></i>
        <p>Arctic</p>
      </a>
    </div>
    <div class="filter">
      <a href="/listings" class="filter">
        <i class="fa-solid fa-border-all" aria-hidden="true"></i>
        <p>All</p>
      </a>
    </div>
    <div class="tax-toggle m-start" class="filter">
      <div class="form-check-reverse form-switch" role="switch">
        <input
          class="form-check-input"
          type="checkbox"
          defaultunchecked
          role="switch"
          id="switchCheckDefault"
        />
        <label class="form-check-label" for="switchCheckDefault"
           >Display total after taxes</label
        >
      </div>

      
  </div>
  <!-- <form action="/listings/new" method="get">
    <button>Create New Listing</button>
  </form> -->

  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for(let listing of allListings){ %>
    <a href="listings/<%=listing.id%>" class="listing-link">
      <div class="card col listing-card">
        <img
          src="<%=listing.image.url%>"
          class="card-img-top"
          alt="listing image"
          style="height: 20rem"
        />
        <div class="card-img-overlay"></div>
        <div class="card-body">
          <p class="card-text">
            <%=listing.title%><br />
            <%=listing.price.toLocaleString("en-IN")%>/ night
            <i class="tax-info"> +18% GST</i>
          </p>
        </div>
      </div>
    </a>
    <% } %>
  </div>
</body>

<script>
  const toggle = document.getElementById("switchCheckDefault");
  toggle.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for(info of taxInfo){
      if(toggle.checked){
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });
</script>
